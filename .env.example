# ── S3 credentials ─────────────────────────────────────────────────────────────
# REQUIRED in production — change both values before deploying.
# These are used by the s3 service AND forwarded to the API server/workers
# via S3__ACCESS_KEY_ID / S3__SECRET_ACCESS_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── API authentication ──────────────────────────────────────────────────────────
# Set one of the two options below to protect the transcription endpoints.
# Single key:
# API_KEY=your-secret-key
# JSON file mapping key → client name (see dependencies.py for format):
# API_KEYS_FILE=/run/secrets/api_keys.json

# ── Hugging Face token ──────────────────────────────────────────────────────────
# Required for gated models (e.g. pyannote diarization).
# HF_TOKEN=hf_...

# ── Whisper model ───────────────────────────────────────────────────────────────
# WHISPER__MODEL=large-v3
# WHISPER__COMPUTE_TYPE=float16      # int8 | float16 | bfloat16 | float32
# WHISPER__INFERENCE_DEVICE=cuda     # cpu | cuda | auto
# WHISPER__BATCH_SIZE=12
# WHISPER__CHUNK_SIZE=30

# ── Concurrency / performance ───────────────────────────────────────────────────
# MAX_CONCURRENT_TRANSCRIPTIONS=1   # GPU slots; 1 is safe for a single GPU
# IO_EXECUTOR_WORKERS=4

# ── Kafka (distributed mode only) ──────────────────────────────────────────────
# KAFKA__BOOTSTRAP_SERVERS=kafka:9092
# KAFKA__REQUEST_TOPIC=transcription-requests
# KAFKA__REPLY_TOPIC=transcription-replies
# KAFKA__REPLY_TIMEOUT_SECONDS=3600 # Inactivity timeout: worker progress events reset it
# KAFKA__MAX_PENDING_JOBS=100       # In-flight jobs the API will queue; 0 = unlimited
# KAFKA__SESSION_TIMEOUT_MS=120000  # Worker group eviction tolerance for event-loop stalls
# KAFKA__JOB_LEASE_TTL_SECONDS=300  # Processing lease TTL; bounds crash-recovery takeover latency

# ── Object storage (distributed mode only) ─────────────────────────────────────
# NOTE: a bare `STORAGE=fs` crashes startup — pydantic decodes it as the whole
# sub-model. Always use the STORAGE__* form.
# STORAGE__BACKEND=s3               # s3 | fs
# STORAGE__DELETE_AFTER_DOWNLOAD=true

# ── S3 (storage backend s3) ────────────────────────────────────────────────────
# S3__ENDPOINT_URL=http://s3:9000
# S3__BUCKET=whisperx-audio
# S3__REGION=us-east-1
# S3__OBJECT_EXPIRY_DAYS=1          # Days before uploaded audio is auto-deleted
# Audio larger than one part is uploaded multipart, bounding the RAM and the
# inline SigV4 payload hashing that a single PutObject would do on the event loop.
# S3__MULTIPART_PART_SIZE=8388608   # Part size in bytes (min 5 MiB)
# S3__MULTIPART_CONCURRENCY=4       # Parts in parallel; RAM ≈ part size × this

# ── Shared filesystem (storage backend fs) ─────────────────────────────────────
# Must be visible at the SAME path in every API and worker container. Startup
# refuses mounts that cannot do an atomic create-if-absent (see docs/storage.md).
# STORAGE__FS__ROOT=/srv/whisperx    # confinement boundary; required for backend fs
# STORAGE__FS__PREFIX=whisperx       # whisperx's own subtree under the root
# STORAGE__FS__DIR_MODE=770          # octal, no 0o prefix
# STORAGE__FS__FILE_MODE=660
# STORAGE__FS__RETENTION_DAYS=1      # 0 = never sweep
# STORAGE__FS__SWEEP_INTERVAL_SECONDS=3600
# STORAGE__FS__ALLOW_UNSAFE_MOUNT=false

# ── Inputs written by OTHER services (Kafka `file_path` events) ────────────────
# SECURITY: this accepts filesystem paths from the request topic. Enable it only
# when the producers on that topic are trusted. Paths are confined to the root,
# our own subtree is excluded, and the source file is never deleted.
# INPUT_FS__ENABLED=false
# INPUT_FS__ROOT=                    # empty = inherit STORAGE__FS__ROOT
# INPUT_FS__ALLOWED_DIRS=["/srv/whisperx/files"]   # empty = anywhere under the root

# ── Web UI (optional) ───────────────────────────────────────────────────────────
# Serve the bundled browser UI at /webui. Requires assets built into the image
# (docker compose build with BUILD_WEBUI=build in the environment / this file) or a
# local `cd webui && bun install --frozen-lockfile && bun run build`.
# WEBUI__ENABLED=true
# BUILD_WEBUI=build                 # compose build arg: build the UI into the image
# WEBUI__DIST_DIR=/path/to/webui/dist  # only for non-standard asset locations

# ── Logging ─────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── CORS ────────────────────────────────────────────────────────────────────────
# ALLOW_ORIGINS=["https://your-frontend.example.com"]
